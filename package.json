{
  "name": "voice-to-ship",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently --kill-others -n api,web \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "APP_ENV=preview node --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lenis": "^1.3.11",
    "motion": "^12.23.24",
    "mysql2": "^3.24.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0",
    "vanta": "^0.5.24"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^10.0.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
